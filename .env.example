# Copy to .env in the project root and fill in secrets before starting.
# Keep all real configuration in .env (ignored by Git). This template is safe to commit.

DODO_HOST=0.0.0.0
DODO_PORT=8888
DODO_STORAGE_BACKEND=mysql
DODO_FILE_STORAGE_BACKEND=minio

# Existing mysql8 container: host port 3316, database aicc.
DODO_MYSQL_HOST=127.0.0.1
DODO_MYSQL_PORT=3316
DODO_MYSQL_DATABASE=aicc
DODO_MYSQL_USER=your_mysql_user
DODO_MYSQL_PASSWORD=CHANGE_ME

# Existing redis5 container.
DODO_REDIS_ENABLED=true
DODO_REDIS_HOST=127.0.0.1
DODO_REDIS_PORT=6389
DODO_REDIS_DATABASE=0
DODO_REDIS_PASSWORD=CHANGE_ME

# Existing minio container.
DODO_MINIO_ENDPOINT=http://127.0.0.1:9000
DODO_MINIO_ACCESS_KEY=minioadmin
DODO_MINIO_SECRET_KEY=CHANGE_ME
DODO_MINIO_BUCKET=rag-test2
DODO_MINIO_PUBLIC_READ=true

# Existing postgres15-pgvector container.
DODO_VECTOR_ENABLED=true
DODO_VECTOR_HOST=127.0.0.1
DODO_VECTOR_PORT=5432
DODO_VECTOR_DATABASE=dodo_agentx
DODO_VECTOR_USER=admin
DODO_VECTOR_PASSWORD=CHANGE_ME
DODO_VECTOR_TABLE=vector_file_info
DODO_VECTOR_DIMENSION=1024

# DeepSeek chat model and separate embedding/search services.
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
DODO_MODEL=deepseek-chat
DODO_EMBEDDING_API_KEY=
DODO_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DODO_EMBEDDING_MODEL=text-embedding-v4
DODO_MULTIMODAL_MODEL=qwen3-vl-plus
TAVILY_API_KEY=

# 决策模型（System One 协议，与 TypeSafe Jev 同接口）。未配置则意图级联走大模型判定。
# 复用 DODO_EMBEDDING_API_KEY 即可；也可单独指定 DODO_DECISION_API_KEY。
# DODO_DECISION_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DODO_DECISION_MODEL=decision-model-preview

# Optional remote-profile differences, stored in the same .env.
# Python/Shell: select with DODO_ENV_PROFILE=remote.
# run_python_backend.ps1 selects the remote profile by default.
REMOTE_DODO_MYSQL_HOST=your_remote_mysql_host
REMOTE_DODO_REDIS_HOST=your_remote_redis_host
REMOTE_DODO_MINIO_ENDPOINT=http://your_remote_minio_host:9000
REMOTE_DEEPSEEK_API_KEY=YOUR_REMOTE_API_KEY
REMOTE_OPENAI_BASE_URL=https://your_remote_model_endpoint/v1

# ---- 上下文工程与长期记忆（默认开启；OpenViking 未配置时退回本地状态）----
# HOTLINE_CONTEXT_ENABLED=true
# HOTLINE_CONTEXT_WINDOW=128000
# HOTLINE_CONTEXT_INPUT_BUDGET=64000
# HOTLINE_CONTEXT_OUTPUT_RESERVE=8192
# HOTLINE_CONTEXT_SAFETY_MARGIN=2048
# HOTLINE_OPENVIKING_URL=http://127.0.0.1:1933
# HOTLINE_OPENVIKING_API_KEY=
# HOTLINE_OPENVIKING_TIMEOUT=10

# ---- 语义召回评测开关（需真实 embedding 服务时才打开）----
# HOTLINE_SEMANTIC_EVAL=0

# ---- 文档解析（MinerU 精确抽取，默认不启用）----
# MINERU_TOKEN=
# DODO_MINERU_BASE_URL=https://mineru.net
# DODO_MINERU_MODEL_VERSION=vlm
# DODO_MINERU_POLL_INTERVAL=5
# DODO_MINERU_TIMEOUT=900

# ---- 存储与运行数据目录（默认落在 Git 忽略的 data/ 下）----
# DODO_DATA_DIR=data
# DODO_UPLOAD_DIR=data/uploads
# DODO_GENERATED_DIR=data/generated
# DODO_MAX_FILE_SIZE=52428800
# DODO_MAX_TEXT_LENGTH=20000
# DODO_LARGE_FILE_THRESHOLD=5000
# DODO_CHUNK_SIZE=800
# DODO_CHUNK_OVERLAP=100
# DODO_DOC_COMPENSATE_INTERVAL=300
# DODO_MYSQL_POOL_SIZE=20
# DODO_REDIS_TIMEOUT=5
# DODO_REDIS_TASK_TTL=1800
# DODO_VECTOR_PARENT_TABLE=document_parent_chunk

# ---- 模型与 Embedding 备选凭据 ----
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# DODO_DECISION_API_KEY=
# DODO_MULTIMODAL_API_KEY=

# ---- 技能包目录（仓库技能与已安装技能分别管理）----
# DODO_REPO_SKILLS_DIRECTORY=skills
# SKILLS_DIRECTORY=data/skills
# DODO_SKILL_CENTER_DB=data/skill-center/catalog.db

# ---- 本地环境文件加载 ----
# DODO_ENV_FILE=.env
# DODO_ENV_PROFILE=remote

# ---- 共享密钥鉴权（两端一致；留空表示不启用，行为与启用前一致）----
# HOTLINE_API_TOKEN=

# ---- SSE 保护（默认不限制；0 表示关闭）----
# HOTLINE_SSE_LIMIT=0
# HOTLINE_SSE_IDLE_TIMEOUT=0

# ---- Java 统一入口 ----
# HOTLINE_JAVA_HOST=127.0.0.1
# HOTLINE_JAVA_PORT=8080
# DODO_DEV_FRONTEND_PORT=5180
# DODO_DEV_FRONTEND_URL=

# ---- Java 寻址与 Nacos 注册发现（跨主机部署时才需要）----
# HOTLINE_PYTHON_MODE=static
# HOTLINE_PYTHON_BASE_URL=http://127.0.0.1:8888
# HOTLINE_PYTHON_SERVICE_NAME=hotline-python-api
# HOTLINE_PYTHON_CONNECT_TIMEOUT=1
# HOTLINE_PYTHON_READ_TIMEOUT=60
# HOTLINE_PYTHON_NACOS_ENABLED=false
# HOTLINE_PYTHON_ADVERTISED_IP=
# HOTLINE_PYTHON_ADVERTISED_PORT=8888
# HOTLINE_NACOS_ENABLED=false
# HOTLINE_NACOS_REGISTER_ENABLED=false
# HOTLINE_NACOS_SERVER_ADDR=127.0.0.1:8848
# HOTLINE_NACOS_NAMESPACE=
# HOTLINE_NACOS_GROUP=DEFAULT_GROUP
# HOTLINE_NACOS_USERNAME=
# HOTLINE_NACOS_PASSWORD=
# HOTLINE_NACOS_ADVERTISED_IP=

# ---- Java 启动时拉起本地 Python 与执行 Worker ----
# HOTLINE_PYTHON_AUTOSTART=true
# HOTLINE_PYTHON_EXECUTABLE=
# HOTLINE_PYTHON_ROOT=
# HOTLINE_PYTHON_STARTUP_TIMEOUT=30
# HOTLINE_PYTHON_WORKER_INSTANCES=2

# ---- 机器人页的 CI 工作流开关 ----
# GitHub Token：只在本机 .env 里填，带仓库权限（可启停 Actions 工作流）；不要提交到仓库
# HOTLINE_GITHUB_TOKEN=
# 目标仓库与工作流文件（owner/repo 与仓库里的工作流文件名）
# HOTLINE_GITHUB_REPOSITORY=owner/repo
# HOTLINE_GITHUB_CI_WORKFLOW=ci.yml

# 技能中心（已并入后端，默认无需配置；仅当需要改数据库位置或项目 ID 时覆盖）
# DODO_SKILL_CATALOG_DB=data/skill-center/catalog.db
# DODO_SKILL_PROJECT=hotline-agent
# Skill 自进化 / 独立评分模型（可选；不配置则 auto_evolve 与 judge 不可用）
# SKILL_EVOLUTION_BASE_URL=
# SKILL_EVOLUTION_API_KEY=
# SKILL_EVOLUTION_MODEL=
# SKILL_JUDGE_BASE_URL=
# SKILL_JUDGE_API_KEY=
# SKILL_JUDGE_MODEL=
# SKILL_ROLLOUT_ERROR_THRESHOLD=0.05
# SKILL_ROLLOUT_MIN_SAMPLES=30

