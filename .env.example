# Copy to .env in the Hotline root and fill in secrets before starting.
# Keep all real configuration in .env (ignored by Git). This template is safe to commit.

DODO_HOST=0.0.0.0
DODO_PORT=8888
DODO_STORAGE_BACKEND=mysql
DODO_FILE_STORAGE_BACKEND=minio

# Existing mysql8 container: host port 3316, database aicc.
DODO_MYSQL_HOST=127.0.0.1
DODO_MYSQL_PORT=3316
DODO_MYSQL_DATABASE=aicc
DODO_MYSQL_USER=your_mysql_user
DODO_MYSQL_PASSWORD=CHANGE_ME

# Existing redis5 container.
DODO_REDIS_ENABLED=true
DODO_REDIS_HOST=127.0.0.1
DODO_REDIS_PORT=6389
DODO_REDIS_DATABASE=0
DODO_REDIS_PASSWORD=CHANGE_ME

# Existing minio container.
DODO_MINIO_ENDPOINT=http://127.0.0.1:9000
DODO_MINIO_ACCESS_KEY=minioadmin
DODO_MINIO_SECRET_KEY=CHANGE_ME
DODO_MINIO_BUCKET=rag-test2
DODO_MINIO_PUBLIC_READ=true

# Existing postgres15-pgvector container.
DODO_VECTOR_ENABLED=true
DODO_VECTOR_HOST=127.0.0.1
DODO_VECTOR_PORT=5432
DODO_VECTOR_DATABASE=dodo_agentx
DODO_VECTOR_USER=admin
DODO_VECTOR_PASSWORD=CHANGE_ME
DODO_VECTOR_TABLE=vector_file_info
DODO_VECTOR_DIMENSION=1024

# DeepSeek chat model and separate embedding/search services.
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
DODO_MODEL=deepseek-chat
DODO_EMBEDDING_API_KEY=
DODO_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DODO_EMBEDDING_MODEL=text-embedding-v4
DODO_MULTIMODAL_MODEL=qwen3-vl-plus
TAVILY_API_KEY=

# Optional remote-profile differences, stored in the same .env.
# Python/Shell: select with DODO_ENV_PROFILE=remote.
# run_python_backend.ps1 selects the remote profile by default.
REMOTE_DODO_MYSQL_HOST=your_remote_mysql_host
REMOTE_DODO_REDIS_HOST=your_remote_redis_host
REMOTE_DODO_MINIO_ENDPOINT=http://your_remote_minio_host:9000
REMOTE_DEEPSEEK_API_KEY=YOUR_REMOTE_API_KEY
REMOTE_OPENAI_BASE_URL=https://your_remote_model_endpoint/v1
